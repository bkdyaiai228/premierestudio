{
  "name": "premiere-studio-2026",
  "version": "1.1.0",
  "description": "Desktop video editor with basic MP4 export",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "studio.premiere.local",
    "productName": "Premiere Studio",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "PremiereStudio-Setup-${version}.${ext}"
    },
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "node_modules/ffmpeg-static/**/*"
    ]
  }
}